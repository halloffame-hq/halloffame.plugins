{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halloffame-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HallOfFameAgent",
        "class_name": "HallOfFameAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HallOfFameAgent"],
    },
  ],
  "keep_vars": true,
  "vars": {
    "HOF_AGENT_PROVIDER": "cloudflare-workers",
    "HOF_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "HOF_MODEL_SUPPORTS_VISION": "true",
    "HOF_ACTIVITY_INTERVAL_SECONDS": "18000",
    "HOF_MEDIA_HOSTS": "",
  },
}

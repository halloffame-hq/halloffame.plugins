<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="40dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <TextView android:id="@+id/hof_call_app_name" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08" android:textAllCaps="true" android:textColor="#B3FFFFFF"
        android:textSize="12sp" />
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <FrameLayout android:layout_width="132dp" android:layout_height="132dp"
        android:background="@drawable/hof_call_avatar">
        <TextView android:id="@+id/hof_call_caller_initial" android:layout_width="match_parent"
            android:layout_height="match_parent" android:fontFamily="sans-serif-medium"
            android:gravity="center" android:textColor="#F8FAFC" android:textSize="48sp"
            tools:text="A" />
    </FrameLayout>
    <TextView android:id="@+id/hof_call_caller" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="28dp" android:ellipsize="end"
        android:fontFamily="sans-serif-medium" android:gravity="center" android:maxLines="2"
        android:textColor="#FFFFFF" android:textSize="28sp" tools:text="Ada Lovelace" />
    <TextView android:id="@+id/hof_call_subtitle" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center"
        android:textColor="#B3FFFFFF" android:textSize="16sp" tools:text="Incoming video call" />
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:orientation="horizontal">
        <LinearLayout android:layout_width="112dp" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical">
            <ImageButton android:id="@+id/hof_call_decline" android:layout_width="68dp"
                android:layout_height="68dp" android:background="@drawable/hof_call_action_decline"
                android:contentDescription="@string/hof_call_decline" android:padding="20dp"
                android:scaleType="fitCenter" android:src="@drawable/hof_ic_call_end"
                android:tint="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/hof_call_decline"
                android:textColor="#FFFFFF" android:textSize="14sp" />
        </LinearLayout>
        <Space android:layout_width="40dp" android:layout_height="1dp" />
        <LinearLayout android:layout_width="112dp" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical">
            <ImageButton android:id="@+id/hof_call_answer" android:layout_width="68dp"
                android:layout_height="68dp" android:background="@drawable/hof_call_action_answer"
                android:contentDescription="@string/hof_call_answer" android:padding="20dp"
                android:scaleType="fitCenter" android:src="@drawable/hof_ic_call_answer"
                android:tint="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/hof_call_answer"
                android:textColor="#FFFFFF" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

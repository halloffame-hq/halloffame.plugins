{
  "name": "@hallofame/capacitor-calls",
  "version": "0.1.4",
  "description": "Native incoming-call support for Hall Of Fame reseller applications.",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "android/",
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit && vitest run && tsdown",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0",
    "@capacitor/push-notifications": ">=8.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "tsdown": "^0.22.13"
  },
  "publishConfig": {
    "access": "public"
  }
}